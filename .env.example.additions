# ---- Append to the Statamic skeleton's .env.example -------------------------
APP_NAME="company-name CMS"

# Local: SQLite (Herd free tier has no MySQL). Forge: mysql + the project_name_cms database/user.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=project_name_cms
# DB_USERNAME=project_name_cms
# DB_PASSWORD=

QUEUE_CONNECTION=database

# Statamic
STATAMIC_PRO_ENABLED=true
STATAMIC_LICENSE_KEY=                 # production only (SREs, statamic.com Site)
STATAMIC_API_ENABLED=true
STATAMIC_API_AUTH_TOKEN=              # long random string: php -r "echo bin2hex(random_bytes(32));"
STATAMIC_REVISIONS_ENABLED=true
STATAMIC_GIT_ENABLED=false
STATAMIC_STATIC_CACHING_STRATEGY=null
STATAMIC_CUSTOM_CMS_NAME="company-name CMS"
# STATAMIC_CUSTOM_LOGO_URL=/brand/logo.svg
# STATAMIC_CUSTOM_FAVICON_URL=/brand/favicon.svg

# Assets: local (storage/app/public/assets) now, s3 later (see config-snippets/filesystems.php)
ASSETS_DISK_DRIVER=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# ASSETS_URL=

# Front end (Nuxt)
FRONTEND_URL=http://localhost:3000
FRONTEND_DEPLOY_HOOK_URL=             # empty locally = no rebuilds
FRONTEND_BUILDS_PAUSED=false          # true during big imports

# WordPress export source (wp:pull) - read-only
WP_BASE_URL=
WP_API_USER=
WP_API_APP_PASSWORD=
